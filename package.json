{
  "name": "ngx-email-studio-workspace",
  "version": "21.0.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build ngx-email-studio && ng build demo",
    "build:lib": "ng build ngx-email-studio",
    "build:demo": "ng build demo",
    "watch": "ng build ngx-email-studio --watch --configuration development",
    "test": "ng test",
    "smoke:tiptap": "node scripts/tiptap-smoke.mjs",
    "smoke:tiptap-cursor": "node scripts/tiptap-cursor-smoke.mjs",
    "pack:lib": "npm pack ./dist/ngx-email-studio",
    "build:pages": "ng build ngx-email-studio && ng build demo --base-href /ngx-email-studio/",
    "deploy:pages": "bash scripts/deploy-demo-pages.sh"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/cdk": "^21.2.13",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@tiptap/core": "^3.25.0",
    "@tiptap/extension-link": "^3.25.0",
    "@tiptap/extension-table": "^3.25.0",
    "@tiptap/extension-table-cell": "^3.25.0",
    "@tiptap/extension-table-header": "^3.25.0",
    "@tiptap/extension-table-row": "^3.25.0",
    "@tiptap/extension-text-align": "^3.25.0",
    "@tiptap/extension-text-style": "^3.25.0",
    "@tiptap/starter-kit": "^3.25.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.13",
    "@angular/cli": "^21.2.13",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.60.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
